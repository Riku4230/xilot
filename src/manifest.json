{
  "manifest_version": 3,
  "name": "Xilot",
  "version": "0.1.0",
  "description": "Translate X (Twitter) articles into Japanese using AI",
  "permissions": ["sidePanel", "activeTab", "storage", "scripting", "unlimitedStorage"],
  "host_permissions": ["*://x.com/*", "*://twitter.com/*", "http://127.0.0.1:4501/*", "http://localhost:4501/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://x.com/*", "*://twitter.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Xilot"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
